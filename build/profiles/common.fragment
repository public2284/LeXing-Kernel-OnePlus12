# Common fragment: applied to every profile before the profile fragment.
#
# The OnePlusOSS release does not publish kernel/oplus_cpu (their scheduler
# feature tree), while kernel/sched/walt* reaches into it under these six
# CONFIG guards. The published include/linux fallbacks (cpufreq_health.h,
# task_overload.h) stay enabled; everything that would include or link
# ../kernel/oplus_cpu is forced off so the OSS tree builds as published.
# See docs/phase2/SOURCE_PINNING.md and patches/0200/0210/0220 for the
# Kconfig-side half of the same problem.

# CONFIG_OPLUS_ADD_CORE_CTRL_MASK is not set
# CONFIG_OPLUS_FEATURE_SCHED_ASSIST is not set
# CONFIG_OPLUS_FEATURE_FRAME_BOOST is not set
# CONFIG_OPLUS_FEATURE_PIPELINE is not set
# CONFIG_OPLUS_FEATURE_VT_CAP is not set
# CONFIG_OPLUS_CPUFREQ_IOWAIT_PROTECT is not set
# CONFIG_OPLUS_FEATURE_PERFORMANCE_SCHED is not set
# CONFIG_OPLUS_FEATURE_GKI_CPUFREQ_BOUNCING is not set
# CONFIG_OPLUS_FEATURE_LOADBALANCE is not set
# CONFIG_OPLUS_FEATURE_ABNORMAL_FLAG is not set
# CONFIG_OPLUS_FEATURE_OCH is not set

# drivers/dma-buf/heaps/mm_boost_pool/ is another unpublished symlink tree.
# CONFIG_OPLUS_FEATURE_MM_BOOSTPOOL=y in the vendor config would compile
# ./mm_boost_pool/oplus_boost_pool.o from it; force it off for the same
# reason as the kernel/oplus_cpu features above.
# CONFIG_OPLUS_FEATURE_MM_BOOSTPOOL is not set
# Vendor modules that reference OPLUS headers not published in the OSS release
# (mm_kevent_fb / boot_mode / oplus_audio_switch chains) cannot be built from
# public sources; the stock modules remain in vendor_dlkm, so they stay off
# here. See patches/0260 for the audit.
# CONFIG_QCOM_WCD_USBSS_I2C is not set
# CONFIG_QCOM_FSA4480_I2C is not set
# CONFIG_QCOM_Q6V5_COMMON is not set
# CONFIG_QCOM_Q6V5_PAS is not set
# CONFIG_I2C_MSM_GENI is not set
# CONFIG_INPUT_QCOM_HV_HAPTICS is not set
# CONFIG_QCOM_STATS and CONFIG_OPLUS_NFC also depend on the unpublished
# oplus project header chain (get_project); disabled for the same reason.
# CONFIG_QCOM_STATS is not set
# CONFIG_OPLUS_NFC is not set