# Pinned third-party sources. Commits are frozen; updates are manual, reviewed
# pull requests only (project rule 13.4.2). See docs/phase2/SOURCE_PINNING.md
# and build/source.lock for provenance.

[submodule "kernel"]
    path = kernel
    url = https://github.com/OnePlusOSS/android_kernel_oneplus_sm8650.git
    branch = oneplus/sm8650_b_16.0.0_oneplus12

[submodule "kernel-common"]
    path = kernel-common
    url = https://github.com/OnePlusOSS/android_kernel_common_oneplus_sm8650.git
    branch = oneplus/sm8650_b_16.0.0_oneplus12

[submodule "vendor-modules"]
    path = vendor-modules
    url = https://github.com/OnePlusOSS/android_kernel_modules_and_devicetree_oneplus_sm8650.git
    branch = oneplus/sm8650_b_16.0.0_oneplus12

[submodule "sukisu-nova"]
    path = sukisu-nova
    url = https://github.com/SukiSU-Nova/SukiSU-Nova.git
    branch = main

[submodule "AnyKernel3"]
    path = AnyKernel3
    url = https://github.com/Kernel-SU/AnyKernel3.git
    branch = master
