# AnyKernel3 flashable-zip overrides, consumed by build/package_anykernel3.sh
# and verified by build/checks/device_params.sh. One KEY=VALUE pair per line;
# values are injected into the staged anykernel.sh before zipping.
#
# device.name* come from the Phase 0 baseline (ro.product.device OP595DL1);
# block=boot matches the project decision to touch only the boot partition
# (init_boot / dtbo / vendor_boot stay untouched under route A).

KERNEL_STRING=LeXing Kernel
DEVICE_NAME1=OP595DL1
DEVICE_NAME2=CPH2573
DEVICE_NAME3=CPH2581
DEVICE_NAME4=CPH2583
BLOCK=boot
IS_SLOT_DEVICE=auto
DO_DEVICECHECK=1
