# Build environment pins (docs/VERSIONING.md, docs/BUILD.md).
# Empty values are intentional: every pin is filled during Phase 1/2 after the
# Phase 0 investigation confirms the kernel branch and toolchain requirements.
BASE_IMAGE=

# Base image: official Ubuntu LTS, pinned by digest in build/docker/image.lock.
CLANG_REPO_URL=
CLANG_COMMIT=

# Official AOSP prebuilt clang, fetched from googlesource at a pinned commit.
MKBOOTIMG_REPO_URL=
MKBOOTIMG_COMMIT=

# AOSP host tools for image structure checks, pinned to commits.

# Fetched artifacts are verified against build/docker/checksums.sha256.
