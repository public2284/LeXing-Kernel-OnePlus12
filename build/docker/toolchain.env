# Build environment pins (docs/VERSIONING.md, docs/BUILD.md).
# Every pin is content-addressed: toolchain artifacts are shallow-cloned at a
# fixed git ref and the resolved commit SHA is verified in the Dockerfile
# (project rule 13.4.3: no prebuilt binaries from unverified sources).
# Updates go through reviewed pull requests only (rule 13.4.2).

# Base image: official Ubuntu LTS. The amd64 manifest digest was resolved by
# the first toolchain-image run (2026-11-19) and is verified on every later
# run; the matching index digest is sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289.
BASE_IMAGE=ubuntu:24.04
BASE_DIGEST=sha256:9a04f13b3f80ef056361e30868593b1cfd2279fe19e4081cb93a90bf56819d6a

# Official AOSP prebuilt clang (r487747c = clang 17.0.2, the toolchain the
# device's stock kernel was built with, per the Phase 0 baseline). Shallow-
# cloned from googlesource at branch llvm-r487747, verified against CLANG_PIN.
CLANG_REPO_URL=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86
CLANG_REF=llvm-r487747
CLANG_PIN=eed2fff8b93ce059eea7ccd8fc5eee37f8adb432

# AOSP host tools for image structure checks (mkbootimg / unpack_bootimg).
MKBOOTIMG_REPO_URL=https://android.googlesource.com/platform/system/tools/mkbootimg
MKBOOTIMG_REF=android-14.0.0_r0.102
MKBOOTIMG_PIN=2208a03d874255af1e4eaf6cf7c156fe1dc98943